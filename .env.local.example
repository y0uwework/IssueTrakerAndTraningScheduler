# Copy this file to .env.local and fill in your values.
# These are server-only settings. Never prefix them with NEXT_PUBLIC_.

# SQL Server host. Examples:
#   localhost                 default instance (MSSQLSERVER)
#   localhost\SQLEXPRESS      named instance (requires the SQL Server Browser service)
DB_SERVER=localhost
# Optional TCP port. Leave empty for a named instance; defaults to 1433 otherwise.
DB_PORT=
DB_DATABASE=IssueTrackerDB

# Authentication: "sql" (SQL Server login, default) or "windows" (needs: npm install msnodesqlv8 + ODBC driver)
DB_AUTH=sql
DB_USER=your_sql_username
DB_PASSWORD=your_sql_password

# Only used when DB_AUTH=windows. Must match a driver listed in "ODBC Data Sources (64-bit)" > Drivers.
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Local SQL Server usually has a self-signed certificate: keep encryption off, or set both to true.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- New Joiners > "Import from Image" (AI reads the joining sheet from a screenshot) ---
# Set ONE of these keys. Images are sent to that provider; nothing is stored there by this app.
# If both are set, OpenAI is used unless AI_PROVIDER says otherwise.
AI_PROVIDER=
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-terra
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
